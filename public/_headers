# Security headers for the static client (SPEC §12 SEC-04).
# connect-src allows the same-origin API and Azure Speech (browser SDK, Phase 3).
# OpenAI is only ever called from the Worker, so it is not listed here.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src 'self' https://*.api.cognitive.microsoft.com https://*.speech.microsoft.com wss://*.speech.microsoft.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=()
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
