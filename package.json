{
  "name": "shuolab",
  "version": "0.1.0",
  "private": true,
  "description": "ShuoLab — private single-user Mandarin immersion learning PWA",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/ensure-dev-vars.mjs && pnpm db:migrate:local",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/prepare-e2e.mjs",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply shuolab --local",
    "db:migrate:remote": "wrangler d1 migrations apply shuolab --remote",
    "curriculum:import": "tsx scripts/import-curriculum.ts",
    "colloquial:import": "tsx scripts/import-colloquial.ts",
    "curriculum:verify": "tsx scripts/verify-curriculum.ts",
    "seed:dev": "tsx scripts/seed-dev-fixtures.ts",
    "icons": "node scripts/generate-icons.mjs",
    "check:deploy": "node scripts/check-deploy-config.mjs",
    "deploy": "pnpm check:deploy && pnpm build && wrangler deploy",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "jose": "6.2.17",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/workers-types": "5.20261113.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "workbox-window": "7.4.1",
    "wrangler": "4.161.0"
  }
}
