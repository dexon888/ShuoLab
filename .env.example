# ShuoLab local configuration — placeholder names only, never real values.
#
# Local development: `pnpm dev` copies this file to `.dev.vars` (git-ignored)
# the first time it runs. Edit `.dev.vars`, not this file.
# Production: set secrets with `wrangler secret put <NAME>`; see README.

# --- Local development only -------------------------------------------------
# APP_ENV overrides the "production" default in wrangler.jsonc.
APP_ENV=development
# Skips Cloudflare Access checks on localhost. The Worker refuses every API
# request if this is "true" while APP_ENV is anything but development/test.
DEV_AUTH_BYPASS=true

# --- Cloudflare Access (required in production) -----------------------------
# OWNER_EMAIL=
# ACCESS_TEAM_DOMAIN=
# ACCESS_AUD=

# --- Providers (optional; fake providers are used locally when unset) -------
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Price overrides in US dollars per million tokens. Set both, or neither to
# use the built-in price for the default model.
# OPENAI_INPUT_USD_PER_MTOK=
# OPENAI_OUTPUT_USD_PER_MTOK=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
